# FIRONOVA — backend environment
#
# Copy to backend/.env and fill in real values. Never commit backend/.env.
# Anything marked REQUIRED has no default: the backend refuses to start without it.

# ---------------------------------------------------------------------------
# Database (REQUIRED)
# ---------------------------------------------------------------------------
MONGO_URL=mongodb://localhost:27017
# Must match the database your deployment already uses. Pointing this at a new
# name gives you an empty store, not an error — check your existing value first.
DB_NAME=

# ---------------------------------------------------------------------------
# Secrets (REQUIRED)
# ---------------------------------------------------------------------------
# Long random string. Changing it invalidates every existing session.
JWT_SECRET=
# Seeds/rotates the admin account on startup. Changing it revokes open sessions.
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Identity & URLs
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@fironova.com
ADMIN_NOTIFICATION_EMAIL=admin@fironova.com
# Required in production — every emailed link is built from it.
PUBLIC_BASE_URL=https://fironova.com
FRONTEND_URL=https://www.fironova.com
APP_ENV=production

# ---------------------------------------------------------------------------
# CORS & cookies
# ---------------------------------------------------------------------------
# Explicit origins only, comma-separated. "*" is rejected at startup because
# the session cookie is credentialed.
CORS_ORIGINS=https://fironova.com,https://www.fironova.com
# Leave EMPTY in production. It exists to let the Emergent preview through,
# whose Cloudflare proxy rewrites Origin to an internal *.emergentcf.cloud host.
CORS_ORIGIN_REGEX=
COOKIE_SECURE=true
COOKIE_SAMESITE=none
# Comma-separated proxy IPs/CIDRs permitted to set forwarding headers.
#
# OBLIGATOIRE si le trafic passe par Cloudflare ou tout reverse proxy.
# Vide, deux problemes opposes :
#   - les en-tetes de transfert ne sont pas crus, donc TOUS les visiteurs
#     partagent l'IP de l'edge : cinq inscriptions ferment le formulaire pour
#     tout le monde (c'est une panne, pas une faille) ;
#   - si on les croyait sans verifier, n'importe qui forgerait son IP et
#     contournerait toutes les limites.
# Plages Cloudflare a jour : https://www.cloudflare.com/ips/
TRUSTED_PROXIES=
TRUST_PROXY_IPS=127.0.0.1,::1
# Optional gate shown before the admin login screen. Not a substitute for auth.
ADMIN_GATE_CODE=

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
SENDER_EMAIL=orders@fironova.com
MAGIC_SENDER_EMAIL=orders@fironova.com

# ---------------------------------------------------------------------------
# Interac e-Transfer
# ---------------------------------------------------------------------------
INTERAC_EMAIL=orders@fironova.com
# Adresse EXACTE depuis laquelle Interac envoie ses avis de depot.
# Comparaison stricte, pas un domaine : une allowlist de domaine accepterait
# encore n'importe quelle autre boite de payments.interac.ca.
# Ne JAMAIS elargir sans raison : une adresse de trop permet de faire confirmer
# une commande sans paiement, avec un courriel forge portant le bon numero et
# le bon montant — deux informations que l'acheteur possede deja.
# Si Interac change d'adresse un jour, les avis ne sont PAS perdus : ils
# partent en reconciliation manuelle dans l'admin, et le journal l'indique.
INTERAC_ALLOWED_SENDERS=notify@payments.interac.ca
INTERAC_PASSWORD_HINT=FIRONOVA
# Microsoft Graph mailbox polling for automatic payment matching. Leave blank
# to confirm Interac payments manually.
INTERAC_GRAPH_TENANT_ID=
INTERAC_GRAPH_CLIENT_ID=
INTERAC_GRAPH_CLIENT_SECRET=
INTERAC_GRAPH_USER=
INTERAC_GRAPH_POLL_SECONDS=300

# ---------------------------------------------------------------------------
# NOWPayments (crypto)
# ---------------------------------------------------------------------------
# With no API key the crypto flow falls back to a mock and hands the customer
# a placeholder address. Set both, or disable crypto checkout.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_PAYOUT_ENABLED=false
NOWPAYMENTS_EMAIL=
NOWPAYMENTS_PASSWORD=

# ---------------------------------------------------------------------------
# Canada Post
# ---------------------------------------------------------------------------
CANADA_POST_API_KEY=
CANADA_POST_CUSTOMER_NUMBER=
CANADA_POST_ORIGIN_POSTAL_CODE=
CANADA_POST_ENVIRONMENT=prod
CANADA_POST_CONTRACT_ID=
CANADA_POST_DEFAULT_SERVICE_CODE=
CANADA_POST_LABEL_FORMAT=
CANADA_POST_SENDER_NAME=
CANADA_POST_SENDER_ADDRESS=
CANADA_POST_SENDER_CITY=
CANADA_POST_SENDER_PROVINCE=
CANADA_POST_SENDER_PHONE=

# ---------------------------------------------------------------------------
# Store behaviour (optional — sensible defaults in code)
# ---------------------------------------------------------------------------
SHIPPING_FLAT_CAD=20
FREE_SHIPPING_THRESHOLD_CAD=200
UNPAID_ORDER_TTL_HOURS=12
PAYMENT_REMINDER_HOURS=6
ORDER_CUTOFF_HOUR=14
ORDER_CUTOFF_TZ=America/Toronto
MAX_COA_UPLOAD_MB=10
MAX_IMAGE_UPLOAD_MB=8
# Caps percent discounts on standard coupons only; affiliate coupons are exempt.
# Leave blank to disable the cap.
STANDARD_COUPON_MAX_PERCENT=
LAUNCH_COUPON_CODE=
AFFILIATE_COUPON_PERCENT=10
PRELAUNCH_ENABLED=false
PRELAUNCH_PREVIEW_TOKEN=

# ---------------------------------------------------------------------------
# Test & seed scripts only — never set these in production
# ---------------------------------------------------------------------------
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
TEST_AFFILIATE_PASSWORD=
DEMO_AFFILIATE_EMAIL=
DEMO_AFFILIATE_PASSWORD=
