# Copy this file to .env and fill with real values.
# Never commit .env.

# Core auth secrets (required)
APP_ENV=production
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=fironova
JWT_SECRET=replace-with-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-strong-admin-password
ADMIN_NOTIFICATION_EMAIL=admin@example.com
# Short browser access session, renewed through a rotating HttpOnly refresh cookie.
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Backend public/base URLs
# PUBLIC_BASE_URL is required in production (used for all emailed links).
PUBLIC_BASE_URL=https://api.example.com
FRONTEND_URL=https://www.example.com
# Explicit browser origins allowed to call the API with credentials.
# Comma-separated, no paths and never use "*".
CORS_ORIGINS=https://www.example.com
# Optional and intended only for tightly scoped ephemeral preview domains.
CORS_ORIGIN_REGEX=
# Comma-separated IPs/CIDRs of reverse proxies allowed to supply Forwarded headers.
# Keep empty for direct internet traffic; never use 0.0.0.0/0.
TRUSTED_PROXIES=
# Deprecated compatibility alias; prefer TRUSTED_PROXIES and keep this empty.
TRUST_PROXY_IPS=
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Canada Post (required when shipping integration is enabled)
#
# POSTES CANADA A CESSE DE SERVIR XML ET SOAP LE 30 AVRIL 2026. Les pages
# officielles de Shipping 8.0.0 et de Rating 4.0.0 l'annoncent dans les memes
# mots : les protocoles sont desormais REST uniquement, et un jeton OAuth 2.0
# est obligatoire pour TOUTES les requetes.
#
# Les deux variables OAuth ci-dessous sont donc OBLIGATOIRES. La seule cle API
# ne suffit plus : sans elles, tarification, etiquettes et reperage parlent a
# un serveur qui ne repond plus. Elles se creent sur le portail developpeur.
CANADA_POST_OAUTH_CLIENT_ID=
CANADA_POST_OAUTH_CLIENT_SECRET=
#
# Le numero de client reste necessaire : il sert de mailedBy / mobo dans
# l'URL. Il n'authentifie plus rien a lui seul.
CANADA_POST_CUSTOMER_NUMBER=
CANADA_POST_ORIGIN_POSTAL_CODE=
#
# Conserve pour l'ancien chemin, qui n'est plus selectionne par defaut.
CANADA_POST_API_KEY=
#
# « prod » ou « dev ». Ne regit que l'hote de l'ancienne API ; le nouveau
# portail distingue essai et production par les IDENTIFIANTS (une
# « application de test » appelle le meme point d'acces sans etre facturee),
# pas par l'hote. En production, toute autre valeur que « prod » refuse le
# demarrage.
CANADA_POST_ENVIRONMENT=prod
#
# Format d'etiquette : « 4x6 » (thermique, 101,6 x 152,4 mm) ou « 8.5x11 »
# (feuille lettre). Encodage PDF dans les deux cas.
CANADA_POST_LABEL_FORMAT=4x6

# Optional sender info
CANADA_POST_SENDER_NAME=
CANADA_POST_SENDER_ADDRESS=
CANADA_POST_SENDER_CITY=
CANADA_POST_SENDER_PROVINCE=
CANADA_POST_SENDER_PHONE=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.example.com/api/auth/google/callback

# NOWPayments (optional if crypto checkout is enabled)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Interac auto-confirm mode
# - off: always manual reconciliation in admin (recommended if you do not use Graph)
# - strict: enable auto-confirm attempts through Microsoft Graph using vars below
INTERAC_AUTOCONFIRM_MODE=off
INTERAC_EMAIL=orders@example.com
INTERAC_TRUSTED_SENDER=
INTERAC_GRAPH_TENANT_ID=
INTERAC_GRAPH_CLIENT_ID=
INTERAC_GRAPH_CLIENT_SECRET=
INTERAC_GRAPH_USER=

# Transactional email
RESEND_API_KEY=
SENDER_EMAIL=orders@example.com
MAGIC_SENDER_EMAIL=
# Expéditeur des invitations du programme d'affiliation. Laissé vide, il
# retombe sur MAGIC_SENDER_EMAIL puis SENDER_EMAIL.
# IMPORTANT : cette adresse doit être vérifiée chez Resend, sinon les
# invitations échouent en boucle alors que le reste des courriels part.
AFFILIATE_SENDER_EMAIL=

# Launch coupon is never provisioned unless explicitly enabled.
LAUNCH_COUPON_ENABLED=false
LAUNCH_COUPON_CODE=LAUNCH15

# Optional: cap percent discounts for standard coupons only.
# Leave empty to disable this cap. Affiliate-linked coupons are never capped by this setting.
STANDARD_COUPON_MAX_PERCENT=

# Shared MongoDB rate limit applied to every mutating /api request, per IP/minute.
PUBLIC_MUTATION_MAX_PER_MINUTE=120

# Operational queues: bounded batch size and maximum batches drained per watchdog run.
OPERATIONAL_BATCH_SIZE=500
OPERATIONAL_MAX_BATCHES_PER_RUN=20
