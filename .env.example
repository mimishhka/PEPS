# Copy this file to .env and fill with real values.
# Never commit .env.

# Core auth secrets (required)
JWT_SECRET=replace-with-long-random-secret
ADMIN_PASSWORD=replace-with-strong-admin-password

# Backend public/base URLs
# PUBLIC_BASE_URL is required in production (used for all emailed links).
PUBLIC_BASE_URL=https://api.example.com
FRONTEND_URL=https://www.example.com

# Canada Post (required when shipping integration is enabled)
CANADA_POST_API_KEY=
CANADA_POST_CUSTOMER_NUMBER=
CANADA_POST_ORIGIN_POSTAL_CODE=
CANADA_POST_ENVIRONMENT=prod

# Optional sender info
CANADA_POST_SENDER_NAME=
CANADA_POST_SENDER_ADDRESS=
CANADA_POST_SENDER_CITY=
CANADA_POST_SENDER_PROVINCE=
CANADA_POST_SENDER_PHONE=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.example.com/api/auth/google/callback

# NOWPayments (optional if crypto checkout is enabled)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Interac auto-confirm mode
# - off: always manual reconciliation in admin (recommended if you do not use Graph)
# - strict: enable auto-confirm attempts through Microsoft Graph using vars below
INTERAC_AUTOCONFIRM_MODE=off
INTERAC_GRAPH_TENANT_ID=
INTERAC_GRAPH_CLIENT_ID=
INTERAC_GRAPH_CLIENT_SECRET=
INTERAC_GRAPH_USER=

# Optional: cap percent discounts for standard coupons only.
# Leave empty to disable this cap. Affiliate-linked coupons are never capped by this setting.
STANDARD_COUPON_MAX_PERCENT=

# Shared MongoDB rate limit applied to every mutating /api request, per IP/minute.
PUBLIC_MUTATION_MAX_PER_MINUTE=120

# Operational queues: bounded batch size and maximum batches drained per watchdog run.
OPERATIONAL_BATCH_SIZE=500
OPERATIONAL_MAX_BATCHES_PER_RUN=20
