async def _seo_get_settings() -> dict:
    doc = await db.seo_settings.find_one({"id": "global"}, {"_id": 0})  # noqa: F821
    if not doc:
        return dict(SEO_DEFAULTS)
    merged = dict(SEO_DEFAULTS)
    for k in SEO_DEFAULTS:
        if doc.get(k):
            merged[k] = doc[k]
    return merged


