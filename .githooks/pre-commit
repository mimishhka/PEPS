#!/bin/sh
# Verifie le frontend avant chaque commit.
#
# Installation (git ne versionne pas .git/hooks) :
#     git config core.hooksPath .githooks
#     python scripts/verifs/installer.py     # fait la meme chose, plus les droits
#
# Contournement, pour un commit qui n'a rien a voir avec le frontend :
#     git commit --no-verify
#
# Deux principes gouvernent ce fichier.
#
# 1. NE RIEN FAIRE quand rien ne le justifie. Si aucun .jsx ni .js n'est mis en
#    scene, le hook sort immediatement. Un hook qui ralentit les commits sans
#    rapport avec son objet finit contourne par habitude, et ne protege plus
#    rien.
#
# 2. NE JAMAIS BLOQUER pour une raison qui ne regarde pas le code. Si aucun
#    interpreteur Python n'est trouve, on previent et on laisse passer. Un
#    outil de verification qui empeche de travailler quand IL est mal
#    installe se fait desinstaller.

FICHIERS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^frontend/.*\.(jsx|js)$')
[ -z "$FICHIERS" ] && exit 0

# On ESSAIE chaque candidat au lieu de se fier a son existence.
#
# Windows installe un faux « python » — un raccourci vers le Microsoft Store —
# que `command -v` trouve tres bien, mais qui refuse de s'executer et sort en
# erreur. Le hook bloquait alors tout commit en annoncant un echec de
# verification, alors que le code etait sain et qu'aucune sonde n'avait tourne.
PY=""
for c in python3 python py; do
    if command -v "$c" >/dev/null 2>&1 && "$c" -c "pass" >/dev/null 2>&1; then
        PY="$c"
        break
    fi
done

if [ -z "$PY" ]; then
    echo "pre-commit : aucun interpreteur Python trouve — verification ignoree."
    echo "             (les sondes sont dans scripts/verifs/)"
    exit 0
fi

echo "pre-commit : verification du frontend…"

# --cached plutot que l'arbre de travail : on verifie ce qui SERA commite, pas
# ce qui traine a cote. Un fichier corrige mais non ajoute ne doit pas faire
# passer un commit casse.
RESULTAT=$("$PY" scripts/verifs/verifier.py --cached 2>&1)
CODE=$?

if [ $CODE -ne 0 ]; then
    echo "$RESULTAT"
    echo ""
    echo "Commit interrompu. Corrigez, ou passez outre avec --no-verify."
    exit 1
fi

echo "$RESULTAT" | tail -n 2
exit 0
